{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChronoNote",
  "version": "0.11.1",
  "identifier": "com.chrononote.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ChronoNote",
        "decorations": false,
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 420,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["chrononote"],
          "appLink": false
        }
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzRDJCOUI5NzNDQUM4QzMKUldURHlNcHp1Ym5TUTF6Nm9tRnhPUUh2V29GYmZFbms3K1JBTWpBNnpSVXhhZU0vdWFYK0pNekcK",
      "endpoints": [
        "https://github.com/marien/ChronoNote/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
