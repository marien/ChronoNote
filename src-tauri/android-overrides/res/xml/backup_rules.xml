<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: Google Auto Backup rules (android:fullBackupContent).
     Everything OneDrive-related stays on the device: the sign-in tokens are
     credentials, and the rest (folder link, sync cache, stored base copies) only
     makes sense together with them — restoring it without the token would show
     "connected" on a new phone while every sync fails. Notes themselves are
     synced through OneDrive, not through backup. -->
<full-backup-content>
    <exclude domain="root" path=".onedrive-refresh-token" />
    <exclude domain="root" path=".onedrive-auth.json" />
    <exclude domain="root" path=".onedrive-pending-pkce.json" />
    <exclude domain="root" path=".onedrive-cache.json" />
    <exclude domain="root" path=".onedrive-folder.json" />
    <exclude domain="root" path=".onedrive-advanced.json" />
    <exclude domain="root" path=".onedrive-deleted.json" />
    <exclude domain="root" path=".onedrive-bases" />
</full-backup-content>
