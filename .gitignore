node_modules
dist
dist-ssr
*.local
tauri-dev.log
tauri-build.log

# Playwright E2E artifacts
/test-results
/playwright-report
/playwright/.cache

# Claude Code tooling config (Browser-pane dev-server launch config) —
# not part of the project itself, kept local rather than shared via git.
.claude/

src-tauri/target
src-tauri/gen

# `tauri icon` also emits iOS / Android / Windows-Store / macOS variants.
# ChronoNote ships Windows-only; only the four in tauri.conf.json's `icon`
# array are tracked. Regenerate all with `npx tauri icon docs/design/icon-A-master.svg`.
src-tauri/icons/android/
src-tauri/icons/ios/
src-tauri/icons/Square*Logo.png
src-tauri/icons/StoreLogo.png
src-tauri/icons/64x64.png
src-tauri/icons/icon.png
src-tauri/icons/icon.icns

# Machine-specific Cargo target-dir override (OneDrive-sync workaround) —
# personal to whichever machine needs it; recreate locally if you hit
# "output path is not a writable directory" (see CLAUDE.local.md).
src-tauri/.cargo/config.toml

# Updater signing keypair (§update-check) — the *private* half only; the
# public half is embedded in tauri.conf.json (plugins.updater.pubkey) and
# tracked there. Losing this file + its password means future releases
# can no longer be signed, so back both up somewhere durable (a password
# manager) — see CLAUDE.local.md. Already covered by `*.local` above;
# named explicitly so this isn't ever mistaken for a stray build file.
src-tauri/updater-signing-key.local
src-tauri/updater-signing-key-password.local

.DS_Store
Thumbs.db
